{
  "name": "tts-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Text-to-Speech platform using Microsoft Edge TTS, Express, and React",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "node server/dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "msedge-tts": "^2.0.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "tts",
    "edge-tts",
    "react",
    "express",
    "text-to-speech"
  ],
  "author": "Umair Ashiq",
  "license": "ISC"
}
